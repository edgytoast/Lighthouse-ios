 bool GameEngine::WantsTimedPass(bool recorded, int viPerTick) {
     return recorded && !GfxDebuggerIsDebugging() && (int)GetInterpolationFPS() > 60 / viPerTick;
 }
+
+#ifdef __IOS__
+// LIGHTHOUSE_IOS (overlay 0055, D35/D40): LH_PACE tick sample (src/port/SohIosPace.cpp).
+extern "C" void SohIos_PaceTick(int fps, int viPerTick, int timed);
+#endif
 
 void GameEngine::SetFrameTiming(long long latchNs, unsigned viSerial, bool timed) {
     sFrameViSerial = viSerial;
     sFrameLatchNs = latchNs;
     sFrameTimed = timed;
+#ifdef __IOS__
+    SohIos_PaceTick(timed ? (int)GetInterpolationFPS() : EffectiveLogicFps(), CurrentViPerTick(), timed ? 1 : 0);
+#endif
 }
 
